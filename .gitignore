# Dataset (28 GB — download from KITTI-360 and run prep_project.py, see README §4)
dataset/

# Logs
logs/
*.log

# Notes, slides and generated dataset plots — local only
docs/

# Results trees.
#   results/                 the live tree the runners write to
#   results_<CONDITION>/     the four archived campaigns (~1.3 GB of raw per-run
#                            .txt/.csv) — too big for git; archive them separately
#   results_aggregated/      KEPT: all_conditions.csv + the LaTeX tables are the
#                            reproducible core. Figures are regenerated by
#                            make_assets_offline.py, so they stay out.
results/
results_*/
!results_aggregated/
results_aggregated/figures/

# Images — every figure in this project is generated, never hand-made
*.png
*.jpg
*.jpeg
*.svg

# PDFs, except the thesis itself
*.pdf
!Thesis_Zincenco_Petru.pdf

# Generated at setup by prep_project.py — these hardcode absolute paths to one
# machine, so a clone must regenerate them rather than inherit them
src_pc/configs/sequences/
src_pc/configs/cam_kitti360.yaml

# pySLAM runtime state
slam_state/

# Python
__pycache__/
**/__pycache__/
*.pyc
*.so

# Editors / IDE
.vscode/
.idea/
*.swp
.DS_Store

# Windows download cruft
*:Zone.Identifier
